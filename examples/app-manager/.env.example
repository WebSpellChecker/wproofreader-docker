# Copy to .env and fill in the values. Everything marked "required" must be set,
# the rest has defaults. Guide: README.md

# --- Image versions -----------------------------------------------------------
# WProofreader Server and db-manager are released together and must match.
WPROOFREADER_VERSION=latest
APP_MANAGER_VERSION=latest
# Only if you need a db-manager build that differs from WPROOFREADER_VERSION.
# DB_MANAGER_VERSION=

# The Compose file uses these Docker Hub repositories by default. If your
# release was supplied through a private registry such as Amazon ECR, replace
# the relevant repository and authenticate before starting. Do not include a
# tag here.
# WPROOFREADER_IMAGE=webspellchecker/wproofreader
# DB_MANAGER_IMAGE=webspellchecker/db-manager
# APP_MANAGER_IMAGE=webspellchecker/app-manager

# --- License (required) -------------------------------------------------------
# WProofreader license ticket. App-manager reads the license state from WProofreader Server.
LICENSE_TICKET_ID=

# --- App-manager (required) ---------------------------------------------------
# Laravel encryption key. Generate one with:
#   openssl rand -base64 32 | sed 's/^/base64:/'
# Keep it: changing it later invalidates sessions and invitation links.
APP_KEY=

# --- Database passwords (required) --------------------------------------------
# Set once, before the first start. They are applied when the data volume is created.
MYSQL_ROOT_PASSWORD=
# App-manager -> app_manager_db (user app_manager)
APP_MANAGER_DB_PASSWORD=
# App-manager -> cloud_service (user app_service, created by db-manager)
SERVICE_DB_PASSWORD=
# WProofreader Server -> cloud_service (user appserver, created by db-manager)
APPSERVER_DB_PASSWORD=

# --- Ports and URLs -----------------------------------------------------------
# Host binding and ports. Loopback is the safe default because both applications
# serve plain HTTP. Put a TLS reverse proxy in front for remote access.
BIND_ADDRESS=127.0.0.1
APP_MANAGER_PORT=8080
APPSERVER_PORT=8081
# The URLs users open in the browser. Defaults to http://localhost:<port>.
# Set both when the stack is accessed through a hostname or reverse proxy;
# invitation and setup links are built from APP_MANAGER_URL.
# APP_MANAGER_URL=http://localhost:8080
# APPSERVER_URL=http://localhost:8081/wscservice/api
# Real client IP behind a proxy: generic (default), aws or cloudflare.
# PROXY_TYPE=generic

# --- Mail (optional) ----------------------------------------------------------
# Invitations are e-mailed. With MAIL_MAILER=log they are written to the
# App-manager log instead (docker compose logs app-manager).
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=app-manager@example.com
# MAIL_FROM_NAME=App-manager

# --- Logging ------------------------------------------------------------------
# APP_MANAGER_LOG_LEVEL=info
# DB_MANAGER_LOG_LEVEL=INFO
